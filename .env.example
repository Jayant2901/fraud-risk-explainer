# Copy to .env and fill in. The backend (api/main.py) reads these from the
# process environment — either export them in your shell, or run uvicorn
# with `--env-file .env` (requires python-dotenv to be installed).

# Required for any /api/* route except /api/health. No default — if unset,
# every protected route returns 401. Generate one yourself, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Free key from https://aistudio.google.com/apikey. Without it, /api/score
# still returns the instant decision; only the AI explanation panel falls
# back to a "credentials missing" message.
GEMINI_API_KEY=

# Comma-separated list of origins allowed to call the API. Defaults to
# http://localhost:5173 (the Vite dev server) if unset.
CORS_ORIGINS=http://localhost:5173

# Optional. When set, entity escalation history, the idempotency cache,
# and pending/ready explanations persist in Redis instead of in-process
# memory — surviving restarts and shareable across workers. Unset (the
# default) keeps today's in-process behavior; nothing else changes.
# docker-compose.yml sets this to redis://redis:6379/0 automatically.
REDIS_URL=
