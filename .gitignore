# Dataset (too large for git; regenerate with `python src/download_data.py`)
data/*.csv

# Exported reviewer feedback — real labels from whoever ran the queue on
# this machine, regenerated by GET /api/feedback/export?write_file=true.
# Deliberately not committed: it's per-deployment operational data, not
# a fixture, and committing one session's labels would invite training
# against them by accident.
data/feedback/

# Generated caches (regenerated automatically on first run)
models/sample_data_cache.pkl

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Secrets (never commit real keys — copy .env.example to .env instead)
.env
.env.local

# Editor (machine-specific interpreter path, not portable across clones)
.vscode/

# OS
.DS_Store
Thumbs.db

# Local tooling state
.claude/
